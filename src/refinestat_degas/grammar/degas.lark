// DeGAS/SOGA grammar, restricted to the subset this project's LLM pipeline is
// already prompted to generate (see src/helpers/generation_prompt.py::DEGAS_GRAMMAR).
// This is a narrowing of the full DeGAS/grammars/SOGA.g4 (ANTLR) grammar: no
// array/loop/observe/prune, and at most one multiplicative term per statement.
// Used by SynCode (structuredllm/syncode) for grammar-constrained decoding.

start: toplevel+

// `toplevel` is a distinct (non-inlined) rule so SynCode's SymbolPosMap can count/locate
// top-level generation units without also matching `statement` reductions nested inside
// if/else blocks (ifblock/elseblock reuse `statement` directly, unwrapped) -- this is what
// itergen_degas.py backs up by when a generated unit fails a check.
toplevel: statement

statement: assignment ";"
         | conditional

assignment: SYMVAR "=" rhs

?rhs: multerm
    | atom
    | atom addop atom             -> add_atoms
    | multerm addop atom          -> add_multerm_right
    | atom addop multerm          -> add_multerm_left

multerm: signed_num "*" SYMVAR       -> num_var_mult
        | signed_num "*" dist        -> num_dist_mult
        | SYMVAR "*" SYMVAR          -> var_var_mult

// atom = var | number | distribution, per DEGAS_GRAMMAR's own definition
// (src/helpers/generation_prompt.py: "atom = var | number | distribution")
?atom: SYMVAR                    -> var_atom
     | signed_num                -> num_atom
     | dist                      -> dist_atom

?dist: gm | uniform

gm: "gm" "(" numlist "," numlist "," numlist ")"
// The trailing literal is fixed at 2 in DEGAS_GRAMMAR ("the trailing 2 is a fixed literal,
// never change it"), but a dedicated bare "2" terminal here collides at the lexer level
// with any NUMBER literal starting with digit 2 (e.g. "2.00", "20.00") since SynCode's
// basic lexer is not parser-state-contextual. So this is accepted syntactically as any
// signed_num here and enforced to literally equal 2.00 by DegasChecker instead (semantic
// validity rather than a grammar/lexer-level constraint).
uniform: "uniform" "(" numlist "," signed_num ")"

numlist: "[" signed_num ("," signed_num)* "]"

conditional: "if" bexpr "{" ifblock "}" "else" "{" elseblock "}" "end" "if" ";"
ifblock: statement+
elseblock: statement+

bexpr: SYMVAR CMPOP signed_num

// The sign is a grammar RULE, not part of the NUMBER terminal, and reuses the exact same
// "-" terminal as addop's minus (see addop below) rather than a separate one. This is
// deliberate: SynCode's lexer is a single non-contextual pass over the token stream, so if
// NUMBER's regex included an optional leading "-" (`-?[0-9]...`), a bare "-" character
// generated one token at a time (as SynCode does, incrementally) is ambiguous between
// "the start of a longer negative NUMBER, more digits still to come" and "a complete
// standalone addop token" -- and once the lexer commits to one interpretation for that
// character, incremental (I)LALR parsing can't retroactively undo it, causing a hard parse
// error the moment the rest of the number arrives. Keeping NUMBER unsigned and modelling
// the minus sign as a grammar production instead means there is only ever ONE lexer
// terminal for the "-" character network-wide; the LALR parser (which unlike the lexer IS
// state/context-aware) then correctly decides, from surrounding grammar context, whether a
// given "-" token is a unary sign prefixing signed_num or a binary addop.
signed_num: NUMBER -> pos_num
          | MINUS NUMBER -> neg_num

// `addop` is a lowercase PARSER RULE, not an uppercase terminal -- crucially different
// from `ADDOP: PLUS | MINUS`, which would define a *third*, separate terminal matching the
// same "+"/"-" characters as PLUS/MINUS (since MINUS is also referenced standalone by
// signed_num above), recreating exactly the lexer-level collision this whole PLUS/MINUS
// split exists to avoid. A rule composed of already-lexed terminals introduces no new
// terminal, so there is no new ambiguity: `?addop` auto-inlines (no alias, single child)
// straight to the underlying PLUS/MINUS token, so code reading `str(op)` is unaffected.
PLUS: "+"
MINUS: "-"
?addop: PLUS | MINUS
CMPOP: "==" | "!=" | "<=" | ">=" | "<" | ">"

SYMVAR: /[a-zA-Z][a-zA-Z0-9]*/
NUMBER: /[0-9]{1,3}\.[0-9]{2}/

%import common.WS
%ignore WS
